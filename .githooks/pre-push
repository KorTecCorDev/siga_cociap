#!/bin/sh
# Hook pre-push de SIGA-COCIAP (19/10/2026).
#
# Corre el verificador de integridad estatica antes de cada push: parciales,
# vistas y layouts que existen, rutas que apuntan a metodos publicos y php -l.
# Si algo falla, el push NO sale. Ver database/verificaciones/README.md.
#
# Se activa UNA VEZ por clon:  git config core.hooksPath .githooks

RAIZ=$(git rev-parse --show-toplevel)

if command -v php >/dev/null 2>&1; then
    PHP=php
elif [ -x /c/xampp/php/php.exe ]; then
    PHP=/c/xampp/php/php.exe
else
    echo "pre-push: no se encontro php; no se puede verificar el codigo." >&2
    exit 1
fi

echo "pre-push: verificando integridad del codigo..."
if ! "$PHP" "$RAIZ/database/verificaciones/verif_integridad_rutas.php"; then
    echo "" >&2
    echo "pre-push: push CANCELADO. Corrige los fallos de arriba y vuelve a intentar." >&2
    exit 1
fi
